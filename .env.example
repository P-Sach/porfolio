# Copy to .env.local for local dev; set the same variables in Vercel → Project → Settings → Environment Variables.
# Without these the public site still works (it serves the built-in content) and /admin shows a setup notice.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Server-only: never prefix with NEXT_PUBLIC_, never commit, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single account allowed into /admin. Must match the user you create in Supabase Auth.
ADMIN_EMAIL=you@example.com
